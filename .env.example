POSTGRES_DB=signalements
POSTGRES_USER=signalements
POSTGRES_PASSWORD=remplacer
POSTGRES_PORT=5432

REDIS_PASSWORD=remplacer
REDIS_PORT=6379

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/signalements
SPRING_DATASOURCE_USERNAME=signalements
SPRING_DATASOURCE_PASSWORD=remplacer
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=remplacer

APP_FRONTEND_ORIGIN=http://localhost:3000

ACCESS_ADMIN_USERNAME=admin
ACCESS_ADMIN_PASSWORD=remplacer

FACNO_BASE_URL=https://facnordc.dgirdc.cd/appmobile/api/ReportedProblems
FACNO_API_KEY=remplacer
REPORTS_IMPORT_ON_STARTUP=true
# Analyse automatique après import ; désactiver uniquement pour suspendre la file de traitement.
REPORT_ANALYSIS_ENABLED=true

MISTRAL_API_KEY=remplacer
MISTRAL_OCR_MODEL=mistral-ocr-latest

# URL complète, avec /ocr ; jeton partagé avec API_TOKEN dans Flask.
HERDYS_OCR_BASE_URL=
HERDYS_OCR_API_TOKEN=
HERDYS_OCR_MODEL=mistral
HERDYS_OCR_TIMEOUT=200s

# Compte superviseur dédié aux courriers et rapports ; à défaut, le compte administrateur configuré.
LETTERS_AUTOMATION_USERNAME=
LETTERS_CRON="0 0 7 * * MON"

UNIKRON_ENDPOINT=
UNIKRON_USER_NAME=
UNIKRON_APP_KEY=
UNIKRON_SENDER_ID=FACNO RDC
UNIKRON_MODE=development

ARAKAPAY_BASE_URL=https://araka-api-uat.azurewebsites.net
ARAKAPAY_EMAIL=
ARAKAPAY_PASSWORD=
ARAKAPAY_MODE=sandbox
ARAKAPAY_LIVE_ENABLED=false
