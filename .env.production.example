# Coolify génère automatiquement SERVICE_PASSWORD_64_POSTGRES et SERVICE_PASSWORD_64_REDIS.
# Saisir ces valeurs dans Environment Variables de la ressource Coolify.
APP_FRONTEND_ORIGIN=https://signalements.example.com
POSTGRES_DB=signalements
POSTGRES_USER=signalements
SERVICE_PASSWORD_64_POSTGRES=
SERVICE_PASSWORD_64_REDIS=
ACCESS_ADMIN_USERNAME=admin
ACCESS_ADMIN_PASSWORD=
FACNO_API_KEY=
MISTRAL_API_KEY=

# URL complète, avec /ocr ; jeton partagé avec API_TOKEN dans Flask.
HERDYS_OCR_BASE_URL=
HERDYS_OCR_API_TOKEN=
HERDYS_OCR_MODEL=mistral
HERDYS_OCR_TIMEOUT=200s
REPORTS_SCHEDULE_ENABLED=true
REPORT_ANALYSIS_ENABLED=true
UNIKRON_ENDPOINT=
UNIKRON_USER_NAME=
UNIKRON_APP_KEY=
UNIKRON_SENDER_ID=FACNO RDC
# Le Compose verrouille UNIKRON_MODE=development jusqu'au GO.

ARAKAPAY_BASE_URL=https://araka-api-uat.azurewebsites.net
ARAKAPAY_EMAIL=
ARAKAPAY_PASSWORD=
ARAKAPAY_MODE=sandbox
ARAKAPAY_LIVE_ENABLED=false
